# ==============================================================================
# NEXUS — Zero-Cost Local Operations Environment Configuration Template
#
# Budget: ₹0 / month. Absolutely no cloud provisioning, paid services, or external APIs.
#
# Quickstart:
#   1. Copy this file to .env (which is git-ignored):
#      cp .env.zero_cost.template .env
#   2. Populate secure random values for placeholders (e.g. openssl rand -hex 32)
#      or run ./scripts/start_local.ps1 (automatically initializes .env if missing).
#   3. Start local infrastructure:
#      powershell ./scripts/start_local.ps1
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & OPERATIONAL IDENTITY
# ------------------------------------------------------------------------------
APP_NAME="NEXUS"
APP_TITLE="NEXUS — Agentic Business Intelligence Platform"
APP_VERSION="0.1.0"
APP_ENV="development"
DEBUG=false
LOG_LEVEL="INFO"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
API_V1_PREFIX="/api/v1"
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# ------------------------------------------------------------------------------
# 2. LOCAL DATABASE CONFIGURATION (PostgreSQL 16 + pgvector)
# ------------------------------------------------------------------------------
# Reuses existing PostgreSQL 16 staging container on host port 5433
POSTGRES_SERVER="127.0.0.1"
POSTGRES_PORT=5433
POSTGRES_DB="nexus_staging_db"
POSTGRES_USER="nexus_staging_user"
POSTGRES_PASSWORD="GENERATE_LOCAL_POSTGRES_PASSWORD_MIN_16_CHARS"
DATABASE_URL="postgresql+psycopg://nexus_staging_user:GENERATE_LOCAL_POSTGRES_PASSWORD_MIN_16_CHARS@127.0.0.1:5433/nexus_staging_db"
TEST_DATABASE_URL="postgresql+psycopg://nexus_staging_user:GENERATE_LOCAL_POSTGRES_PASSWORD_MIN_16_CHARS@127.0.0.1:5433/nexus_test_db"
REQUIRE_POSTGRES=true

# ------------------------------------------------------------------------------
# 3. LOCAL REDIS 7 CONFIGURATION (Cache, Rate Limiting, Idempotency)
# ------------------------------------------------------------------------------
REDIS_URL="redis://127.0.0.1:6380/0"
REDIS_FAIL_CLOSED=true
REDIS_REQUIRED=true

# ------------------------------------------------------------------------------
# 4. ZERO-COST LOCAL EMAIL DISPATCH (Mailpit Integration)
# ------------------------------------------------------------------------------
# Mailpit runs locally on port 1025 for SMTP and provides a browser UI at http://localhost:8025
SMTP_HOST="127.0.0.1"
SMTP_PORT=1025
USE_MAILPIT=true
PULSE_FROM_EMAIL="pulse@nexus.local"

# ------------------------------------------------------------------------------
# 5. ZERO-COST LOCAL ENVELOPE ENCRYPTION (LocalDevelopmentKMSProvider)
# ------------------------------------------------------------------------------
# Local development KMS provider uses AES-256-GCM authenticated envelope encryption
# with tenant-bound AAD. Zero cloud KMS costs. (Strictly prohibited in production).
NEXUS_KMS_PROVIDER="local"
NEXUS_DEV_KMS_MASTER_KEY="GENERATE_LOCAL_DEV_KMS_MASTER_KEY_256BITS"

# ------------------------------------------------------------------------------
# 6. LOCAL AUTHENTICATION & SECURITY TOKENS
# ------------------------------------------------------------------------------
SECRET_KEY="GENERATE_LOCAL_SECRET_KEY_MIN_32_CHARS"
AUTH_JWT_SECRET="GENERATE_LOCAL_JWT_SECRET_KEY_MIN_32_CHARS"
AUTH_JWT_ALGORITHM="HS256"
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=1440
MULTI_TENANCY_ENABLED=true
API_KEY_ENABLED=false

# ------------------------------------------------------------------------------
# 7. ZERO-COST AI & ANALYTICS LAYER (Deterministic Mock Providers)
# ------------------------------------------------------------------------------
# All LLM and embedding operations run via local deterministic mock providers.
# Zero OpenAI, Anthropic, or external API costs.
LLM_ALLOW_EXTERNAL_CALLS=false
DEFAULT_LLM_PROVIDER="mock"
EMBEDDING_PROVIDER="mock"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536
VECTOR_STORE_TYPE="pgvector"

# ------------------------------------------------------------------------------
# 8. CONTINUOUS INTELLIGENCE & PULSE AUTOMATION SCHEDULER
# ------------------------------------------------------------------------------
CONTINUOUS_SCHEDULER_ENABLED=true
CONTINUOUS_SCHEDULER_AUTOSTART=false
CONTINUOUS_SCHEDULER_INTERVAL_SECONDS=60

# ------------------------------------------------------------------------------
# 9. LOCAL DATA STORAGE
# ------------------------------------------------------------------------------
MAX_DOCUMENT_SIZE_BYTES=52428800   # 50MB
UPLOAD_DIR="./data/uploads"
REPORT_STORAGE_DIR="./data/reports"
