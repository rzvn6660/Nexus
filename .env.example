# ==============================================================================
# NEXUS — Agentic Business Intelligence Platform
# Production & Development Environment Configuration Template
#
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="NEXUS"
APP_TITLE="NEXUS — Agentic Business Intelligence Platform"
APP_VERSION="0.1.0"
APP_ENV="development"              # development | staging | production | test
DEBUG=true                         # MUST be false in production
LOG_LEVEL="INFO"                  # DEBUG | INFO | WARNING | ERROR | CRITICAL
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
API_V1_PREFIX="/api/v1"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
# SQLAlchemy connection URL (format: postgresql+psycopg://user:password@host:port/dbname)
DATABASE_URL="postgresql+psycopg://nexus_user:nexus_password@localhost:5432/nexus_db"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="nexus_db"
POSTGRES_USER="nexus_user"
POSTGRES_PASSWORD="nexus_password"

# Connection Pool & SSL Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800               # Recycle idle connections after 1800s (30m)
DB_SSL_MODE=""                     # disable | allow | prefer | require | verify-ca | verify-full (production mandates: require, verify-ca, or verify-full; insecure modes rejected)
DB_SSL_ROOT_CERT=""                # Optional path to trusted CA root bundle (e.g. /etc/ssl/certs/rds-global-bundle.pem; enables verify-full preference)
DB_ECHO=false

# ------------------------------------------------------------------------------
# 3. LLM PROVIDER CONFIGURATION (Agentic Intelligence Layer)
# ------------------------------------------------------------------------------
DEFAULT_LLM_PROVIDER="openai"      # mock | openai | anthropic | gemini
DEFAULT_LLM_MODEL="gpt-4o"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
MAX_AGENT_ITERATIONS=5
DEFAULT_EXPLANATION_LEVEL="manager" # simple | manager | analyst | technical
# Strict Offline Guardrail: MUST remain false to prevent untrusted customer data transmission to external LLMs
LLM_ALLOW_EXTERNAL_CALLS=false

# ------------------------------------------------------------------------------
# 4. EMBEDDINGS & VECTOR STORE (Business Context RAG)
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER="mock"        # mock | openai
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536
VECTOR_STORE_TYPE="pgvector"     # pgvector
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.2

# ------------------------------------------------------------------------------
# 5. CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. Wildcards (*) are strictly forbidden in production.
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# ------------------------------------------------------------------------------
# 6. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Cryptographic secret for signing sessions and general HMAC (minimum 32 characters)
SECRET_KEY="nexus-insecure-development-secret-key-change-in-production"

# SaaS JWT Secret for user access tokens (must be minimum 32 characters in production)
AUTH_JWT_SECRET="nexus-saas-jwt-secret-key-change-in-production-min-32-chars"
AUTH_JWT_ALGORITHM="HS256"
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=1440
MULTI_TENANCY_ENABLED=true

# Optional lightweight API Key protection for prototype/startup deployment
API_KEY_ENABLED=false              # Set to true to enforce X-API-Key verification
API_KEY="nexus-prototype-secret-api-key"

# Security Headers & Content Security Policy (Phase 32A)
SECURE_HSTS_SECONDS=0              # 0 disables HSTS (default for local dev/testing). Set to 31536000 (1 yr) when HTTPS is strictly enforced.
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=false
SECURE_CSP_ENABLED=true
SECURE_CSP_REPORT_ONLY=true        # Safe report-only rollout. Set false to enforce Content-Security-Policy.
SECURE_CSP_REPORT_URI=""           # Optional endpoint or Sentry CSP report ingestion URL
SECURE_PERMISSIONS_POLICY="camera=(), microphone=(), geolocation=(), payment=()"

# ------------------------------------------------------------------------------
# 7. OBSERVABILITY & MONITORING (Phase 32A)
# ------------------------------------------------------------------------------
# Prometheus Operational Metrics
# Exposes /api/v1/metrics and /api/metrics in standard Prometheus text format.
# When APP_ENV=production and METRICS_ENABLED=true, METRICS_AUTH_TOKEN is MANDATORY (fail-closed, min 16 chars).
# Startup fails if METRICS_AUTH_TOKEN is missing, blank, or an insecure placeholder in production.
# Scrapers authenticate via Bearer token ('Authorization: Bearer <token>') or 'X-Metrics-Token: <token>'.
# In non-production environments (development/test), METRICS_AUTH_TOKEN is optional.
# Set METRICS_ENABLED=false to completely disable the metrics endpoint and collector.
METRICS_ENABLED=true
METRICS_AUTH_TOKEN=""

# Sentry Error Tracking & APM
# Optional DSN for error reporting across API and background scheduler processes.
# When empty or omitted, error tracking is safely disabled.
# Passwords, tokens, cookies, auth headers, and request bodies are strictly redacted before sending.
SENTRY_DSN=""
SENTRY_ENVIRONMENT=""              # Defaults to APP_ENV if empty
SENTRY_RELEASE=""                  # Defaults to NEXUS@<version> if empty
SENTRY_TRACES_SAMPLE_RATE=0.0      # Performance tracing sample rate (0.0 to 1.0)

# ------------------------------------------------------------------------------
# 8. SHARED CACHE, RATE LIMITING & SECURITY STATE
# ------------------------------------------------------------------------------
# Redis connection URL for shared multi-worker rate limiting and JWT revocation.
# In production multi-worker deployments, a shared Redis instance is mandatory
# to enforce consistent cross-worker security state.
# Formats:
#   redis://[[username]:[password]@]host[:port][/database]
#   rediss://[[username]:[password]@]host[:port][/database] (TLS encrypted)
# Example (Docker Compose internal network): redis://redis:6379/0
# Example (Cloud Redis with TLS): rediss://:strongpassword@redis.internal:6380/0
REDIS_URL="redis://localhost:6379/0"

# When true, security-critical paths (JWT revocation check, rate limiting) fail-closed
# (returning HTTP 503) if the shared Redis backend is unreachable.
# Recommended: true for production (prevents bypassed revocation / unshared limits).
# Set to false only for single-worker local development.
REDIS_FAIL_CLOSED=false

MAX_FORECAST_HORIZON=12           # Maximum forecast horizon in periods
DEFAULT_FORECAST_HORIZON=3
MAX_INVESTIGATION_STEPS=8         # Maximum causal diagnostic depth
REQUEST_TIMEOUT_SECONDS=60        # Maximum backend processing timeout
MIN_OBSERVATIONS_MONTHLY=4
MIN_OBSERVATIONS_DAILY=14
FORECASTING_ENABLED=true
INVESTIGATION_ENABLED=true

# ------------------------------------------------------------------------------
# 9. STORAGE & UPLOAD BOUNDARIES
# ------------------------------------------------------------------------------
MAX_DOCUMENT_SIZE_BYTES=5242880    # 5MB maximum document upload size for RAG knowledge
DATA_UPLOAD_MAX_MEMORY_SIZE_MB=50  # 50MB maximum tabular dataset upload size (reconciled with Nginx)
DATA_UPLOAD_MAX_BYTES=52428800     # 50MB in bytes
UPLOAD_DIR="./data/uploads"
DATA_DIR="data"                    # Root storage directory for tenant datasets (mounted to persistent volume)

# ------------------------------------------------------------------------------
# 10. CONTINUOUS INTELLIGENCE BACKGROUND SCHEDULER
# ------------------------------------------------------------------------------
CONTINUOUS_SCHEDULER_ENABLED=true
# Set to false in multi-worker web containers to prevent duplicate execution across workers.
# In production, run the dedicated worker container via: python -m app.scheduler_runner
CONTINUOUS_SCHEDULER_AUTOSTART=true
CONTINUOUS_SCHEDULER_INTERVAL_SECONDS=60
CONTINUOUS_SCHEDULER_BATCH_SIZE=10
CONTINUOUS_SCHEDULER_MAX_BUSINESSES_PER_TICK=50
