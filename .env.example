# ==============================================================================
# NEXUS — Agentic Business Intelligence Platform
# Environment Configuration Template
# 
# Copy this file to .env and adjust the values for your local environment:
#   cp .env.example .env
#
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# Application Settings
APP_NAME="NEXUS"
APP_TITLE="NEXUS — Agentic Business Intelligence Platform"
APP_ENV="development"              # development | staging | production | test
DEBUG=true
LOG_LEVEL="INFO"                  # DEBUG | INFO | WARNING | ERROR | CRITICAL
SECRET_KEY="nexus-insecure-development-secret-key-change-in-production"

# Server Configuration
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
API_V1_PREFIX="/api/v1"

# CORS Configuration (comma-separated list of origins)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# Database Configuration (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql://nexus_user:nexus_password@localhost:5432/nexus_db"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="nexus_db"
POSTGRES_USER="nexus_user"
POSTGRES_PASSWORD="nexus_password"

# Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ==============================================================================
