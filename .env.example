# ==============================================================================
# NEXUS — Agentic Business Intelligence Platform
# Production & Development Environment Configuration Template
#
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# NEVER commit the actual .env file or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="NEXUS"
APP_TITLE="NEXUS — Agentic Business Intelligence Platform"
APP_VERSION="0.1.0"
APP_ENV="development"              # development | staging | production | test
DEBUG=true                         # MUST be false in production
LOG_LEVEL="INFO"                  # DEBUG | INFO | WARNING | ERROR | CRITICAL
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
API_V1_PREFIX="/api/v1"

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL + pgvector)
# ------------------------------------------------------------------------------
# SQLAlchemy connection URL (format: postgresql+psycopg://user:password@host:port/dbname)
DATABASE_URL="postgresql+psycopg://nexus_user:nexus_password@localhost:5432/nexus_db"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="nexus_db"
POSTGRES_USER="nexus_user"
POSTGRES_PASSWORD="nexus_password"

# Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ------------------------------------------------------------------------------
# 3. LLM PROVIDER CONFIGURATION (Agentic Intelligence Layer)
# ------------------------------------------------------------------------------
DEFAULT_LLM_PROVIDER="openai"      # mock | openai | anthropic | gemini
DEFAULT_LLM_MODEL="gpt-4o"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""
MAX_AGENT_ITERATIONS=5
DEFAULT_EXPLANATION_LEVEL="manager" # simple | manager | analyst | technical

# ------------------------------------------------------------------------------
# 4. EMBEDDINGS & VECTOR STORE (Business Context RAG)
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER="mock"        # mock | openai
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSION=1536
VECTOR_STORE_TYPE="pgvector"     # pgvector
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.2

# ------------------------------------------------------------------------------
# 5. CORS CONFIGURATION
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins. Wildcards (*) are strictly forbidden in production.
BACKEND_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173"

# ------------------------------------------------------------------------------
# 6. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
# Cryptographic secret for signing sessions and tokens (minimum 32 characters)
SECRET_KEY="nexus-insecure-development-secret-key-change-in-production"

# Optional lightweight API Key protection for prototype/startup deployment
API_KEY_ENABLED=false              # Set to true to enforce X-API-Key verification
API_KEY="nexus-prototype-secret-api-key"

# ------------------------------------------------------------------------------
# 7. OBSERVABILITY & MONITORING
# ------------------------------------------------------------------------------
METRICS_ENABLED=true
# SENTRY_DSN=""
# OTEL_EXPORTER_OTLP_ENDPOINT=""

# ------------------------------------------------------------------------------
# 8. RATE LIMITING & RESOURCE BOUNDS
# ------------------------------------------------------------------------------
MAX_FORECAST_HORIZON=12           # Maximum forecast horizon in periods
DEFAULT_FORECAST_HORIZON=3
MAX_INVESTIGATION_STEPS=8         # Maximum causal diagnostic depth
REQUEST_TIMEOUT_SECONDS=60        # Maximum backend processing timeout
MIN_OBSERVATIONS_MONTHLY=4
MIN_OBSERVATIONS_DAILY=14
FORECASTING_ENABLED=true
INVESTIGATION_ENABLED=true

# ------------------------------------------------------------------------------
# 9. STORAGE & UPLOAD BOUNDARIES
# ------------------------------------------------------------------------------
MAX_DOCUMENT_SIZE_BYTES=5242880    # 5MB maximum file upload size for knowledge & CSV
UPLOAD_DIR="./data/uploads"
