# ==============================================================================
# NEXUS Staging Environment Configuration Template
#
# Instructions:
#   1. Copy this file to 'staging.env' (which is git-ignored by '*.env'):
#      cp infra/staging/staging.env.example infra/staging/staging.env
#   2. Populate disposable secrets and adjust ports if necessary.
#   3. Always invoke Docker Compose with explicit --env-file:
#      docker compose --env-file infra/staging/staging.env -f infra/staging/docker-compose.staging.yml up -d
#
# DO NOT copy production secrets into this file.
# DO NOT commit the operational 'staging.env' file.
# ==============================================================================

# ------------------------------------------------------------------------------
# Docker Compose & Project Identity (Phase 1/2 Attestation Contract)
# ------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=nexus-staging
COMPOSE_FILE=infra/staging/docker-compose.staging.yml
NEXUS_STAGING_MODE=true

# ------------------------------------------------------------------------------
# Staging Localhost Port Offsets (Bound to 127.0.0.1)
# ------------------------------------------------------------------------------
POSTGRES_PORT=5433
REDIS_PORT=6380
BACKEND_PORT=8001
FRONTEND_PORT=3001

# ------------------------------------------------------------------------------
# PostgreSQL 16 Staging Database
# ------------------------------------------------------------------------------
POSTGRES_DB=nexus_staging_db
POSTGRES_USER=nexus_staging_user
POSTGRES_PASSWORD=replace-with-disposable-staging-password

# Dedicated test gate connection string (points to nexus_test_db provisioned by init script)
TEST_DATABASE_URL=postgresql+psycopg://nexus_staging_user:replace-with-disposable-staging-password@127.0.0.1:5433/nexus_test_db

# ------------------------------------------------------------------------------
# Redis 7 In-Memory Cache (Staging)
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
REDIS_FAIL_CLOSED=true

# ------------------------------------------------------------------------------
# Staging Volumes (Must Match Project Labels)
# ------------------------------------------------------------------------------
DATA_VOLUME=nexus_backend_staging_data
REDIS_VOLUME=nexus_redis_staging_data

# ------------------------------------------------------------------------------
# Host Backup Archive Directory
# ------------------------------------------------------------------------------
BACKUP_ROOT=./backups/staging

# ------------------------------------------------------------------------------
# Application Environment & Strict Security Invariants
# ------------------------------------------------------------------------------
APP_ENV=staging
DEBUG=false
LOG_LEVEL=INFO
REQUIRE_POSTGRES=true
LLM_ALLOW_EXTERNAL_CALLS=false

# Disposable Authentication Secrets (Generate secure random values for local staging)
SECRET_KEY=replace-with-staging-secret-key-min-32-chars
AUTH_JWT_SECRET=replace-with-staging-jwt-secret-min-32-chars
API_KEY_ENABLED=false
API_KEY=

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:3001
WEB_CONCURRENCY=2
DATA_UPLOAD_MAX_MEMORY_SIZE_MB=50

# ------------------------------------------------------------------------------
# Continuous Intelligence Scheduler Configuration
#
# NOTE ON SCHEDULER SEMANTICS & HEALTH PROBES:
# - In backend web API: CONTINUOUS_SCHEDULER_AUTOSTART=false prevents web workers
#   from launching background scheduler loops.
# - In dedicated scheduler container: CONTINUOUS_SCHEDULER_ENABLED controls whether
#   the runner starts the continuous intelligence loop task.
# - When CONTINUOUS_SCHEDULER_ENABLED=false, the scheduler task is not created,
#   which causes app.scheduler_health to report 'unhealthy' (as the probe defines
#   health by task liveness and tick progress).
# - For staging backup/recovery testing, scheduler jobs are kept inactive by default
#   (CONTINUOUS_SCHEDULER_ENABLED=false). To run healthy scheduler drills, set
#   CONTINUOUS_SCHEDULER_ENABLED=true explicitly during that specific drill.
# ------------------------------------------------------------------------------
CONTINUOUS_SCHEDULER_AUTOSTART=false
CONTINUOUS_SCHEDULER_ENABLED=false
CONTINUOUS_SCHEDULER_INTERVAL_SECONDS=300
